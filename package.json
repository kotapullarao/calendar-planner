{
  "name": "calendar-planner",
  "version": "2.2.0",
  "description": "A feature-rich calendar planning PWA with interactive walkthrough, synchronized drag-and-drop, advanced backup system, and comprehensive offline functionality",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8080",
    "serve": "npx serve .",
    "test": "node tests/run.mjs unit",
    "test:e2e": "node tests/run.mjs e2e",
    "test:all": "node tests/run.mjs",
    "lint": "node tests/lint.mjs",
    "check": "npm run lint && npm run test:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotapullarao/calendar-planner.git"
  },
  "keywords": [
    "calendar",
    "planner",
    "pwa",
    "progressive-web-app",
    "vanilla-javascript",
    "offline",
    "mobile-first",
    "responsive",
    "emoji",
    "drag-drop",
    "ios-compatible",
    "touch-friendly",
    "zero-dependencies"
  ],
  "author": "Kota Pullarao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kotapullarao/calendar-planner/issues"
  },
  "homepage": "https://kotapullarao.github.io/calendar-planner",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "dependencies": {}
}
