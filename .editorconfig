# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,css,js,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[manifest.json]
indent_size = 2

[sw.js]
indent_size = 2